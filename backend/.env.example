# Copy this file to backend/.env and fill it in. Never commit the real .env.

# Postgres connection string. For Supabase: Project → Connect → "Session pooler" URI,
# with [YOUR-PASSWORD] replaced by your database password.
# If the password has special characters (@ : / # ?), URL-encode them (e.g. @ → %40).
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Signs login tokens. Use a long random string (at least 32 characters) and keep it secret.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Created automatically on first start if no account with this email exists.
ADMIN_NAME=ShopLine Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Frontend URLs allowed to call the API, comma-separated (no trailing slash).
CORS_ORIGINS=http://localhost:5173

# true = fill an empty database with sample shops, products and orders (demo password: demo1234)
SEED_DEMO_DATA=false

# Optional
# PORT=8080
# DB_POOL_SIZE=5
# JWT_TTL_HOURS=168
