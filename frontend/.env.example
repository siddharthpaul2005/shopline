# Copy to frontend/.env.local for local development.
# On Vercel/Netlify, set these in the project's Environment Variables settings instead.

# URL of the Java backend (no trailing slash)
VITE_API_URL=http://localhost:8080

# true = show the demo account shortcuts on the login page (use with SEED_DEMO_DATA=true on the backend)
VITE_DEMO_MODE=false
